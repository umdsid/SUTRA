"""Patch materialization matching frozen mechanics cores plus Level-0 retention."""

from __future__ import annotations

from ..biology import Patch
from ..identifiers import CellID, PatchID, GraphID, InterfaceID
from .validation import validate_patch


def build_patches(
    core_labels: list[set[int]],
    label_to_barcode: dict[int, str],
    barcode_to_cell_id: dict[str, CellID],
    interface_owner_patch: dict[int, int],
    graph_id: GraphID,
    retention_cell_ids: tuple[CellID, ...] = (),
    retention_interface_ids: tuple[InterfaceID, ...] = (),
) -> tuple[Patch, ...]:
    """
    Build one immutable Patch per mechanics core plus patch -1.

    Patch -1 is a Level-0 retention container, not a mechanics patch.  It holds
    measured cells/interfaces outside the contact-graph partition (including
    boundary-only primary cells and measured cells outside the mechanics
    primary component).
    """
    owned:dict[int,list[int]]={}
    for eid,pid in interface_owner_patch.items():
        owned.setdefault(int(pid),[]).append(int(eid))

    out=[]
    for pid,labels in enumerate(core_labels):
        cells=tuple(sorted(
            (barcode_to_cell_id[label_to_barcode[int(lab)]] for lab in labels),
            key=int
        ))
        eids=tuple(InterfaceID(e) for e in sorted(owned.get(pid,[])))
        p=Patch(
            id=PatchID(pid),graph_id=graph_id,
            cell_ids=cells,interface_ids=eids,
            n_cells=len(cells),n_interfaces=len(eids)
        )
        validate_patch(p);out.append(p)

    if retention_cell_ids or retention_interface_ids:
        p=Patch(
            id=PatchID(-1),graph_id=graph_id,
            cell_ids=tuple(sorted(set(retention_cell_ids),key=int)),
            interface_ids=tuple(sorted(set(retention_interface_ids),key=int)),
            n_cells=len(set(retention_cell_ids)),
            n_interfaces=len(set(retention_interface_ids)),
        )
        validate_patch(p);out.append(p)

    return tuple(out)


__all__=["build_patches"]
