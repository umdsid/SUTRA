{
  "decomposition": {
    "observed": "delta_p",
    "potential": "p_i-p_j",
    "residual": "delta_p-(p_i-p_j)",
    "consistency_ratio": "abs(residual)/(abs(delta_p)+eps)"
  },
  "transport": {
    "pressure_edge_coordinate": "potential component only",
    "residual_used_as_scalar_pressure": false
  },
  "diagnostics": {
    "retain_residual": true,
    "retain_component_labels": true,
    "retain_consistency_ratio": true,
    "consistency_ratio_is_gate": false
  },
  "policy": {
    "remove_constraints": false,
    "clip_outliers": false,
    "rerun_hierarchy": false
  }
}
